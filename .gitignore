.DS_Store

# Machine-generated website data. It lives in the private asb-website-data
# repository and is assembled into data/ at deploy time by
# .github/workflows/deploy.yml.
#
# It is kept out of this public repository on purpose: the site displays only
# current group members, but anything committed here would remain in public
# git history permanently. Keeping it out means a departed member's photo
# stops existing publicly when they stop being displayed.
#
# For a local preview, fetch the published copies:  ./scripts/fetch-data.sh
#
# data/travels.json and data/research-themes.json are hand-authored and ARE
# tracked -- do not add them here.
# No trailing slash on data/photos: it may be a real directory (after
# fetch-data.sh) or a symlink into a local clone of asb-website-data, and a
# trailing slash would only match the directory form, leaving the symlink
# committable.
/data/group_members.json
/data/publications.json
/data/photos

# Assembled output
/_site/

# scripts/check_data.py imports build_nav, which byte-compiles it
__pycache__/
*.pyc
